<style>
  .section {
    padding: 5rem 4rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.5rem;
  }
  .section-title {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .section-num {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--border);
  }

  .filter-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .filter-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-right: 0.25rem;
  }
  .filter-group {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .filter-divider {
    width: 1px;
    height: 20px;
    background: var(--border);
    margin: 0 0.25rem;
  }
  .filter-btn {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--border);
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: transparent;
    cursor: pointer;
    transition: all 0.2s;
  }
  .filter-btn:hover {
    border-color: var(--white);
    color: var(--white);
  }
  .filter-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--white);
  }

  .project-list {
    display: flex;
    flex-direction: column;
  }
  .project-content {
    flex: 1;
  }
  .project-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem 0;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    transition: padding-left 0.25s;
    position: relative;
    overflow: hidden;
    color: inherit;
    gap: 2rem;
  }
  .project-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent);
    transform: scaleY(0);
    transition: transform 0.25s;
  }
  .project-item:hover::before {
    transform: scaleY(1);
  }
  .project-item:hover {
    padding-left: 1.5rem;
  }
  .project-item.hidden {
    display: none;
  }

  .project-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .project-name {
    font-size: 1.6rem;
    width: 100%;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .project-desc {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    margin-top: 0.3rem;
  }
  .project-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-left: auto;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border);
    color: var(--muted);
    letter-spacing: 0.08em;
  }
  .project-year {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  @media (max-width: 1024px) {
    .section {
      padding: 5rem 2.5rem;
    }
    .project-item {
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .section {
      padding: 4rem 1.5rem;
    }

    /* Mengubah grid menjadi satu kolom */
    .project-item {
      grid-template-columns: 40px 1fr; /* Angka urut kecil di samping nama */
      gap: 1rem;
      padding: 1.5rem 0;
    }

    .project-num {
      grid-row: 1;
    }

    /* Memaksa elemen lain pindah ke bawah nama project */
    .project-tags {
      grid-column: 2;
      margin-top: 0.5rem;
    }

    .project-year {
      grid-column: 2;
      justify-self: start; /* Rata kiri di bawah tags */
      font-size: 0.7rem;
      opacity: 0.8;
    }

    .project-name {
      font-size: 1.25rem;
    }

    /* Membuat filter bar bisa di-scroll secara horizontal jika terlalu panjang */
    .filter-bar {
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }

    .filter-group {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 5px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none; /* Sembunyikan scrollbar di Firefox */
    }

    .filter-group::-webkit-scrollbar {
      display: none; /* Sembunyikan scrollbar di Chrome/Safari */
    }

    .filter-btn {
      flex: 0 0 auto; /* Tombol tidak menyusut */
      font-size: 0.6rem;
      padding: 0.25rem 0.6rem;
    }

    .projects-footer {
      flex-direction: column;
      gap: 1.5rem;
      align-items: center;
      text-align: center;
    }

    .load-more-btn {
      width: 100%; /* Tombol lebar penuh di mobile agar mudah diklik */
      justify-content: center;
    }
  }
</style>

